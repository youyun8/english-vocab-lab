{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advanced-english-vocabulary",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "advanced-english-vocabulary",
      // Replace with the id printed by:
      //   npx wrangler d1 create advanced-english-vocabulary
      "database_id": "b56faf7d-4dd4-4810-8056-81224a8d08d6",
      "migrations_dir": "migrations"
    },
    {
      "binding": "advanced_english_vocabulary",
      "database_name": "advanced-english-vocabulary",
      "database_id": "b56faf7d-4dd4-4810-8056-81224a8d08d6",
      "remote": true
    }
  ]
}
