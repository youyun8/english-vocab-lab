{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advanced-english-vocabulary",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "advanced-english-vocabulary",
      // Replace with the id printed by:
      //   npx wrangler d1 create advanced-english-vocabulary
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]

  // No "vars" block on purpose. A name listed here is re-uploaded on every
  // `wrangler deploy` and overwrites the secret of the same name, so an
  // "APP_URL": "http://localhost:5173" default would silently reset a deployed
  // origin back to localhost and make GitHub answer the login with
  // "The redirect_uri is not associated with this application".
  //
  // APP_URL is optional: when it is unset the Worker derives the OAuth redirect
  // URI from the origin of the incoming request. Set it (with
  // `npx wrangler secret put APP_URL`) only to pin a canonical origin.
}
