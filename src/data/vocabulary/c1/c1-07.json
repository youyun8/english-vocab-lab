[
  {
    "id": "w_contradict",
    "lemma": "contradict",
    "slug": "contradict",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ˌkɑntrəˈdɪkt/",
      "syllables": "con·tra·dict",
      "stressNote": "主重音在第三音節 -dict，第一音節有次重音。"
    },
    "forms": {
      "past": "contradicted",
      "pastParticiple": "contradicted",
      "presentParticiple": "contradicting",
      "thirdPersonSingular": "contradicts"
    },
    "senses": [
      {
        "id": "s_contradict_1",
        "partOfSpeech": "verb",
        "register": [
          "formal",
          "academic"
        ],
        "definitionEn": "to state the opposite of what someone has said, or to be inconsistent with something",
        "definitionZh": "反駁；與……相矛盾",
        "usageExplanationZh": "contradict 有兩種主詞：人（當面反駁某人）與事物（兩件事互相矛盾）。前者可能顯得不客氣，後者則是中性的邏輯陳述。技術與學術寫作中多用後者：these two findings contradict each other。反身用法 contradict oneself（自相矛盾）也很常見。",
        "grammarPatterns": [
          "A contradicts B",
          "contradict oneself",
          "be contradicted by + evidence"
        ],
        "collocations": [
          {
            "text": "contradict each other",
            "meaningZh": "互相矛盾",
            "example": {
              "en": "The two log lines contradict each other about when the retry started.",
              "zh": "這兩行日誌對重試何時開始的說法互相矛盾。",
              "highlight": "contradict each other"
            }
          },
          {
            "text": "flatly contradict",
            "meaningZh": "直接牴觸"
          },
          {
            "text": "contradict oneself",
            "meaningZh": "自相矛盾"
          }
        ],
        "examples": [
          {
            "en": "The documentation contradicts the actual behaviour of the API.",
            "zh": "文件的說明與 API 的實際行為互相矛盾。",
            "highlight": "contradicts"
          },
          {
            "en": "New evidence contradicts the conclusion of the earlier study.",
            "zh": "新的證據推翻了先前研究的結論。",
            "highlight": "contradicts"
          }
        ],
        "commonMistakes": [
          {
            "incorrect": "His statement contradicts with the data.",
            "correct": "His statement contradicts the data.",
            "explanationZh": "contradict 是及物動詞，直接接受詞，不加 with。"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "wordId": "w_refute",
        "lemma": "refute",
        "noteZh": "更強，指用證據駁倒。"
      },
      {
        "lemma": "conflict with"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_corroborate",
        "lemma": "corroborate"
      },
      {
        "lemma": "confirm"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "refute",
        "wordId": "w_refute",
        "distinctionZh": "contradict 只是「說法相反」，不保證誰對；refute 宣稱「已用證據證明對方錯了」。若只是提出相反意見而沒有證據，用 contradict 才不會言過其實。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "contradiction",
        "partOfSpeech": "noun",
        "meaningZh": "矛盾"
      },
      {
        "lemma": "contradictory",
        "partOfSpeech": "adjective",
        "meaningZh": "互相矛盾的"
      }
    ],
    "tags": [
      "academic",
      "logic",
      "argument"
    ]
  },
  {
    "id": "w_credible",
    "lemma": "credible",
    "slug": "credible",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ˈkrɛdəbəl/",
      "syllables": "cred·i·ble",
      "stressNote": "重音在第一音節。"
    },
    "senses": [
      {
        "id": "s_credible_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic",
          "business"
        ],
        "definitionEn": "able to be believed or trusted, because it is reasonable and well supported",
        "definitionZh": "可信的；有說服力的",
        "usageExplanationZh": "credible 評價的是「值得相信的程度」，可以形容說法、來源或威脅。它與 plausible 的差別在於強度：plausible 只是「聽起來合理」，credible 則已經有分量到值得採信。留意 credible（可信的）與 credulous（輕信的）意思幾乎相反。",
        "grammarPatterns": [
          "a credible + noun",
          "find something credible"
        ],
        "collocations": [
          {
            "text": "a credible source",
            "meaningZh": "可信的來源"
          },
          {
            "text": "a credible threat",
            "meaningZh": "有實質可能性的威脅",
            "example": {
              "en": "The security team treats this as a credible threat, not a theoretical one.",
              "zh": "資安團隊把這視為實質的威脅，而非僅止於理論。",
              "highlight": "a credible threat"
            }
          },
          {
            "text": "highly credible",
            "meaningZh": "高度可信的"
          },
          {
            "text": "a credible alternative",
            "meaningZh": "可行且可信的替代方案"
          }
        ],
        "examples": [
          {
            "en": "Without a credible rollback plan, the migration should not be approved.",
            "zh": "沒有一份可信的回復計畫，這次遷移不該被核准。",
            "highlight": "credible"
          },
          {
            "en": "Is there any credible evidence that the change caused the regression?",
            "zh": "有任何可信的證據顯示是這項變更造成退步的嗎？",
            "highlight": "credible"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "believable"
      },
      {
        "lemma": "trustworthy",
        "noteZh": "多形容人或機構。"
      }
    ],
    "antonyms": [
      {
        "lemma": "incredible",
        "noteZh": "作「難以置信」解時；日常口語中多作「極好的」。"
      },
      {
        "wordId": "w_spurious",
        "lemma": "spurious"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "plausible",
        "wordId": "w_plausible",
        "distinctionZh": "plausible 是「表面上說得通」，可能一查就破；credible 是「經得起檢視、值得採信」。強度上 plausible < credible。"
      },
      {
        "lemma": "credulous",
        "distinctionZh": "credible 形容「值得被相信的事物」；credulous 形容「太容易相信別人的人」。兩者主詞完全不同，不可互換。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "credibility",
        "partOfSpeech": "noun",
        "meaningZh": "可信度"
      },
      {
        "lemma": "credibly",
        "partOfSpeech": "adverb",
        "meaningZh": "可信地"
      }
    ],
    "tags": [
      "academic",
      "argument",
      "security"
    ]
  },
  {
    "id": "w_deteriorate",
    "lemma": "deteriorate",
    "slug": "deteriorate",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/dɪˈtɪriəˌret/",
      "syllables": "de·te·ri·o·rate",
      "stressNote": "主重音在第二音節 -te-。"
    },
    "forms": {
      "past": "deteriorated",
      "pastParticiple": "deteriorated",
      "presentParticiple": "deteriorating",
      "thirdPersonSingular": "deteriorates"
    },
    "senses": [
      {
        "id": "s_deteriorate_1",
        "partOfSpeech": "verb",
        "register": [
          "formal",
          "technical",
          "business"
        ],
        "definitionEn": "to become gradually worse in quality or condition",
        "definitionZh": "惡化；逐漸變差",
        "usageExplanationZh": "deteriorate 是不及物動詞：東西自己變差，不能說 deteriorate something。它強調「逐漸」，因此適合描述長期趨勢——程式碼品質、服務效能、關係。若要表達「使某物變差」，請用及物的 degrade 或 worsen。",
        "grammarPatterns": [
          "A deteriorates",
          "deteriorate into + noun"
        ],
        "collocations": [
          {
            "text": "steadily deteriorate",
            "meaningZh": "持續惡化"
          },
          {
            "text": "performance deteriorates",
            "meaningZh": "效能變差",
            "example": {
              "en": "Performance deteriorates sharply once the working set exceeds memory.",
              "zh": "一旦工作集超過記憶體容量，效能就會急遽變差。",
              "highlight": "deteriorates"
            }
          },
          {
            "text": "deteriorate into",
            "meaningZh": "惡化成……"
          }
        ],
        "examples": [
          {
            "en": "Code quality deteriorates quietly when nobody owns the module.",
            "zh": "當沒有人負責某個模組時，程式碼品質會在無聲無息中惡化。",
            "highlight": "deteriorates"
          },
          {
            "en": "The discussion deteriorated into an argument about tooling.",
            "zh": "討論最後惡化成一場關於工具的爭吵。",
            "highlight": "deteriorated into"
          }
        ],
        "commonMistakes": [
          {
            "incorrect": "The bug deteriorated the performance.",
            "correct": "The bug degraded the performance.",
            "explanationZh": "deteriorate 不及物，不能接受詞。要說「使……變差」請用 degrade 或 worsen。"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "worsen"
      },
      {
        "lemma": "degrade",
        "noteZh": "可及物，亦可不及物。"
      }
    ],
    "antonyms": [
      {
        "lemma": "improve"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "degrade",
        "distinctionZh": "文法上是關鍵差別：deteriorate 只能不及物（東西自己變差），degrade 可及物也可不及物。因此可以說 the bug degraded performance，卻不能說 the bug deteriorated performance。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "deterioration",
        "partOfSpeech": "noun",
        "meaningZh": "惡化"
      }
    ],
    "tags": [
      "engineering",
      "business",
      "description"
    ]
  },
  {
    "id": "w_discern",
    "lemma": "discern",
    "slug": "discern",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/dɪˈsɝn/",
      "syllables": "dis·cern",
      "stressNote": "重音在第二音節。"
    },
    "forms": {
      "past": "discerned",
      "pastParticiple": "discerned",
      "presentParticiple": "discerning",
      "thirdPersonSingular": "discerns"
    },
    "senses": [
      {
        "id": "s_discern_1",
        "partOfSpeech": "verb",
        "register": [
          "formal",
          "academic",
          "literary"
        ],
        "definitionEn": "to recognise or make out something that is not obvious",
        "definitionZh": "察覺；辨識出（不明顯的事物）",
        "usageExplanationZh": "discern 的前提是「不容易看出來」，因此它常出現在否定或條件句中：no clear pattern can be discerned。這種用法在資料分析與學術寫作中很有用，可以誠實地表達「我們看不出明確的規律」。形容詞 discerning 則是稱讚：眼光獨到的。",
        "grammarPatterns": [
          "discern + noun",
          "discern whether + clause",
          "be discernible"
        ],
        "collocations": [
          {
            "text": "discern a pattern",
            "meaningZh": "看出規律",
            "example": {
              "en": "No clear pattern can be discerned from three days of data.",
              "zh": "只憑三天的資料，看不出明確的規律。",
              "highlight": "discerned"
            }
          },
          {
            "text": "hard to discern",
            "meaningZh": "難以辨識"
          },
          {
            "text": "a discerning reader",
            "meaningZh": "有眼光的讀者"
          }
        ],
        "examples": [
          {
            "en": "It is hard to discern the cause when three changes shipped together.",
            "zh": "當三項變更同時上線時，很難分辨出原因。",
            "highlight": "discern"
          },
          {
            "en": "She discerned the flaw in the argument before anyone else did.",
            "zh": "她比任何人都早看出這個論證的破綻。",
            "highlight": "discerned"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "perceive"
      },
      {
        "lemma": "make out",
        "noteZh": "較口語。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "distinguish",
        "distinctionZh": "discern 是「看出某個不明顯的東西存在」；distinguish 是「分辨兩者之間的差別」。discern a pattern（看出有規律）／distinguish A from B（把 A 和 B 分開）。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "discernible",
        "partOfSpeech": "adjective",
        "meaningZh": "可辨識的"
      },
      {
        "lemma": "discerning",
        "partOfSpeech": "adjective",
        "meaningZh": "有眼光的"
      }
    ],
    "tags": [
      "academic",
      "analysis",
      "data"
    ]
  },
  {
    "id": "w_elicit",
    "lemma": "elicit",
    "slug": "elicit",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ɪˈlɪsɪt/",
      "syllables": "e·lic·it",
      "stressNote": "重音在第二音節 -lic-。"
    },
    "forms": {
      "past": "elicited",
      "pastParticiple": "elicited",
      "presentParticiple": "eliciting",
      "thirdPersonSingular": "elicits"
    },
    "senses": [
      {
        "id": "s_elicit_1",
        "partOfSpeech": "verb",
        "register": [
          "formal",
          "academic",
          "business"
        ],
        "definitionEn": "to draw out a response, reaction, or piece of information from someone",
        "definitionZh": "引出；套出（回應或資訊）",
        "usageExplanationZh": "elicit 的核心是「主動設法讓對方給出反應」，因此它的受詞是 response、reaction、information、feedback 這類抽象名詞。需求訪談中的 elicit requirements（引導出需求）是專業術語，強調需求要靠提問挖掘，而不是等人交出來。",
        "grammarPatterns": [
          "elicit A from B",
          "elicit a response"
        ],
        "collocations": [
          {
            "text": "elicit a response",
            "meaningZh": "引出回應"
          },
          {
            "text": "elicit requirements",
            "meaningZh": "引導出需求",
            "example": {
              "en": "Good analysts elicit requirements instead of waiting to be given them.",
              "zh": "好的分析師會主動挖掘需求，而不是等著別人給。",
              "highlight": "elicit requirements"
            }
          },
          {
            "text": "elicit feedback",
            "meaningZh": "取得回饋"
          }
        ],
        "examples": [
          {
            "en": "The survey failed to elicit any useful information about why users left.",
            "zh": "這份問卷沒能問出任何關於使用者為何離開的有用資訊。",
            "highlight": "elicit"
          },
          {
            "en": "The announcement elicited a strong reaction from the community.",
            "zh": "這則公告在社群中引起了強烈反應。",
            "highlight": "elicited"
          }
        ],
        "usageNotes": [
          "elicit 與 illicit（非法的）發音相同但詞性與意義完全不同，寫作時要特別小心。"
        ],
        "commonMistakes": [
          {
            "incorrect": "The policy was elicit.",
            "correct": "The policy was illicit.",
            "explanationZh": "elicit 是動詞（引出），illicit 是形容詞（非法的）。兩者同音，但不能互換。"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "draw out"
      },
      {
        "lemma": "evoke",
        "noteZh": "偏向引發情緒或回憶。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "illicit",
        "distinctionZh": "同音字：elicit 是動詞「引出」，illicit 是形容詞「非法的」。判斷方式很簡單——句子裡需要動詞就用 elicit。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "elicitation",
        "partOfSpeech": "noun",
        "meaningZh": "引導；蒐集（需求）"
      }
    ],
    "tags": [
      "academic",
      "business",
      "communication"
    ]
  },
  {
    "id": "w_empirical",
    "lemma": "empirical",
    "slug": "empirical",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ɛmˈpɪrɪkəl/",
      "syllables": "em·pir·i·cal",
      "stressNote": "重音在第二音節 -pir-。"
    },
    "senses": [
      {
        "id": "s_empirical_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic",
          "technical"
        ],
        "definitionEn": "based on observation or measurement rather than on theory or pure reasoning",
        "definitionZh": "實證的；基於觀測資料的",
        "usageExplanationZh": "empirical 的核心對比是「觀測 vs. 理論」：empirical evidence 是實際量測或觀察來的證據，與從原理推導出的結論相對。工程討論中它常用來把爭論拉回數據：Do we have any empirical evidence for that? 是一句很有力的提問。",
        "grammarPatterns": [
          "empirical evidence for + noun",
          "an empirical study of + noun"
        ],
        "collocations": [
          {
            "text": "empirical evidence",
            "meaningZh": "實證證據",
            "example": {
              "en": "Do we have empirical evidence that this actually helps, or just intuition?",
              "zh": "我們有實證證據顯示這真的有幫助嗎，還是只是直覺？",
              "highlight": "empirical evidence"
            }
          },
          {
            "text": "an empirical study",
            "meaningZh": "實證研究"
          },
          {
            "text": "empirical data",
            "meaningZh": "實測資料"
          },
          {
            "text": "purely empirical",
            "meaningZh": "純粹經驗性的"
          }
        ],
        "examples": [
          {
            "en": "The rule of thumb is empirical: it works, but nobody can derive it.",
            "zh": "這個經驗法則是實證得來的：確實有效，但沒有人推導得出來。",
            "highlight": "empirical"
          },
          {
            "en": "The paper's claims are theoretical and lack empirical support.",
            "zh": "這篇論文的主張偏理論，缺乏實證支持。",
            "highlight": "empirical"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "observational"
      },
      {
        "lemma": "experimental"
      }
    ],
    "antonyms": [
      {
        "lemma": "theoretical"
      },
      {
        "lemma": "speculative"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "anecdotal",
        "distinctionZh": "兩者都來自觀察，差別在系統性：empirical 指有方法地蒐集、可重複的觀測；anecdotal 指零星的個別見聞。「我覺得變快了」是 anecdotal，量測一萬次請求才是 empirical。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "empirically",
        "partOfSpeech": "adverb",
        "meaningZh": "實證地"
      },
      {
        "lemma": "empiricism",
        "partOfSpeech": "noun",
        "meaningZh": "經驗主義"
      }
    ],
    "tags": [
      "academic",
      "research",
      "data"
    ]
  }
]
