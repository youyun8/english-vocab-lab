[
  {
    "id": "w_exacerbate",
    "lemma": "exacerbate",
    "slug": "exacerbate",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ɪgˈzæsɚˌbet/",
      "syllables": "ex·ac·er·bate",
      "stressNote": "主重音在第二音節 -ac-；ex- 讀作 /ɪgz/。"
    },
    "forms": {
      "past": "exacerbated",
      "pastParticiple": "exacerbated",
      "presentParticiple": "exacerbating",
      "thirdPersonSingular": "exacerbates"
    },
    "senses": [
      {
        "id": "s_exacerbate_1",
        "partOfSpeech": "verb",
        "register": [
          "formal",
          "academic",
          "business"
        ],
        "definitionEn": "to make an already bad situation worse",
        "definitionZh": "加劇；使（本已不佳的情況）惡化",
        "usageExplanationZh": "exacerbate 有一個嚴格的前提：問題本來就存在，這個動作只是讓它更糟。因此它的受詞一定是負面的（problem、shortage、tension、delay）。它正好是 mitigate 的反義詞，兩者常在風險討論中成對出現。",
        "grammarPatterns": [
          "exacerbate + noun",
          "be exacerbated by + noun"
        ],
        "collocations": [
          {
            "text": "exacerbate the problem",
            "meaningZh": "讓問題更嚴重",
            "example": {
              "en": "Adding more workers exacerbated the problem instead of solving it.",
              "zh": "增加更多工作執行緒反而讓問題更嚴重，而不是解決了它。",
              "highlight": "exacerbated the problem"
            }
          },
          {
            "text": "exacerbated by",
            "meaningZh": "因……而加劇"
          },
          {
            "text": "only exacerbate",
            "meaningZh": "只會使……更糟"
          }
        ],
        "examples": [
          {
            "en": "The retry storm exacerbated an outage that would have been brief.",
            "zh": "重試風暴讓原本短暫的中斷變得更加嚴重。",
            "highlight": "exacerbated"
          },
          {
            "en": "Staffing shortages are exacerbated by the on-call rotation.",
            "zh": "值班輪替使人力不足的問題更加惡化。",
            "highlight": "exacerbated by"
          }
        ],
        "usageNotes": [
          "exacerbate 的受詞必須是負面事物。生產力提升是正面結果，應該用 improve 或 boost。誤：The new tool exacerbated our productivity.／正：The new tool improved our productivity."
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "aggravate",
        "noteZh": "使問題惡化。"
      },
      {
        "lemma": "compound",
        "noteZh": "指問題疊加而更嚴重。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_mitigate",
        "lemma": "mitigate",
        "noteZh": "減輕嚴重程度。"
      },
      {
        "lemma": "alleviate",
        "noteZh": "緩解痛苦或問題。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "aggravate",
        "distinctionZh": "在「使更嚴重」的意思上兩者同義，但 aggravate 在口語中另有「惹惱某人」的常見義（it aggravates me）。技術與學術寫作中用 exacerbate 較不會產生歧義。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "exacerbation",
        "partOfSpeech": "noun",
        "meaningZh": "加劇"
      }
    ],
    "tags": [
      "academic",
      "risk",
      "business"
    ]
  },
  {
    "id": "w_facilitate",
    "lemma": "facilitate",
    "slug": "facilitate",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/fəˈsɪləˌtet/",
      "syllables": "fa·cil·i·tate",
      "stressNote": "主重音在第二音節 -cil-。"
    },
    "forms": {
      "past": "facilitated",
      "pastParticiple": "facilitated",
      "presentParticiple": "facilitating",
      "thirdPersonSingular": "facilitates"
    },
    "senses": [
      {
        "id": "s_facilitate_1",
        "partOfSpeech": "verb",
        "register": [
          "formal",
          "business",
          "academic"
        ],
        "definitionEn": "to make a process easier or more likely to happen, without doing it yourself",
        "definitionZh": "促進；使……更容易進行",
        "usageExplanationZh": "facilitate 的關鍵在於「幫忙讓事情變順利，但自己不是主角」。因此主持會議的人叫 facilitator——他不做決定，只讓討論順利進行。受詞是過程或活動，不是人：可以說 facilitate the discussion，但不能說 facilitate the team。",
        "grammarPatterns": [
          "facilitate + noun (a process)",
          "facilitate + doing"
        ],
        "collocations": [
          {
            "text": "facilitate discussion",
            "meaningZh": "促進討論"
          },
          {
            "text": "facilitate collaboration",
            "meaningZh": "促進協作",
            "example": {
              "en": "Shared dashboards facilitate collaboration between the two teams.",
              "zh": "共用的儀表板促進了兩個團隊之間的協作。",
              "highlight": "facilitate collaboration"
            }
          },
          {
            "text": "facilitate a workshop",
            "meaningZh": "主持工作坊"
          }
        ],
        "examples": [
          {
            "en": "The new API does not solve the problem; it merely facilitates a solution.",
            "zh": "新的 API 並沒有解決問題，只是讓解法比較好做。",
            "highlight": "facilitates"
          },
          {
            "en": "She facilitated the retrospective without steering the conclusions.",
            "zh": "她主持了回顧會議，但沒有引導結論的方向。",
            "highlight": "facilitated"
          }
        ],
        "usageNotes": [
          "會議中的 facilitator 是「引導者」而非「主持人兼決策者」——其職責是讓討論順利進行，不介入結論。",
          "facilitate 不能接「人 + to do」的結構。要說「使某人能夠做某事」請用 enable somebody to do。誤：The tool facilitates us to deploy faster.／正：The tool enables us to deploy faster."
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "enable",
        "noteZh": "可接 somebody to do。"
      },
      {
        "lemma": "ease",
        "noteZh": "使過程更容易。"
      }
    ],
    "antonyms": [
      {
        "lemma": "hinder",
        "noteZh": "阻礙進展。"
      },
      {
        "lemma": "impede",
        "noteZh": "妨礙行動或進展。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "enable",
        "distinctionZh": "enable 是「讓原本不可能的事變成可能」，且可接 enable A to do B；facilitate 是「讓已經可能的事變得更順利」，受詞只能是過程。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "facilitator",
        "partOfSpeech": "noun",
        "meaningZh": "會議主持人；促成者"
      },
      {
        "lemma": "facilitation",
        "partOfSpeech": "noun",
        "meaningZh": "促成；引導"
      }
    ],
    "tags": [
      "business",
      "communication",
      "process"
    ]
  },
  {
    "id": "w_indispensable",
    "lemma": "indispensable",
    "slug": "indispensable",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ˌɪndɪˈspɛnsəbəl/",
      "syllables": "in·dis·pens·a·ble",
      "stressNote": "主重音在第三音節 -pens-，第一音節有次重音。"
    },
    "senses": [
      {
        "id": "s_indispensable_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "business"
        ],
        "definitionEn": "so important or useful that it is impossible to manage without it",
        "definitionZh": "不可或缺的",
        "usageExplanationZh": "indispensable 是很強的形容詞：沒有它就辦不成事。介系詞用 to 或 for。它常出現在關於「單點失效」的討論中：如果某位同事變得 indispensable，那其實是組織的風險，而不是對他的稱讚。",
        "grammarPatterns": [
          "indispensable to + noun",
          "indispensable for + doing"
        ],
        "collocations": [
          {
            "text": "indispensable to",
            "meaningZh": "對……不可或缺",
            "example": {
              "en": "Version control is indispensable to any team larger than one.",
              "zh": "只要團隊超過一個人，版本控制就是不可或缺的。",
              "highlight": "indispensable to"
            }
          },
          {
            "text": "an indispensable tool",
            "meaningZh": "不可或缺的工具"
          },
          {
            "text": "become indispensable",
            "meaningZh": "變得無可取代"
          }
        ],
        "examples": [
          {
            "en": "Good logging is indispensable when you cannot reproduce a bug.",
            "zh": "當錯誤無法重現時，良好的日誌是不可或缺的。",
            "highlight": "indispensable"
          },
          {
            "en": "If one engineer is indispensable, the team has a problem.",
            "zh": "如果某位工程師變得無可取代，那是團隊的問題。",
            "highlight": "indispensable"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "essential",
        "noteZh": "必要的。"
      },
      {
        "lemma": "vital",
        "noteZh": "至關重要的。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_redundant",
        "lemma": "redundant",
        "noteZh": "多餘、不再需要的。"
      },
      {
        "lemma": "dispensable",
        "noteZh": "可以省去的。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "essential",
        "distinctionZh": "essential 是「本質上必要的」，強調屬於核心；indispensable 是「少了它就辦不成」，強調無可替代。氧氣對生命是 essential，某位掌握全部知識的同事則是 indispensable——後者對組織其實是風險。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "dispensable",
        "partOfSpeech": "adjective",
        "meaningZh": "可有可無的"
      }
    ],
    "tags": [
      "business",
      "evaluation",
      "risk"
    ]
  },
  {
    "id": "w_intuitive",
    "lemma": "intuitive",
    "slug": "intuitive",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ɪnˈtuətɪv/",
      "syllables": "in·tu·i·tive",
      "stressNote": "重音在第二音節 -tu-。"
    },
    "senses": [
      {
        "id": "s_intuitive_1",
        "partOfSpeech": "adjective",
        "register": [
          "neutral",
          "technical",
          "business"
        ],
        "definitionEn": "easy to understand or use without being taught, because it works the way people expect",
        "definitionZh": "直覺的；符合直覺、不必學就會用的",
        "usageExplanationZh": "在產品與介面設計中，intuitive 是最高的稱讚之一：使用者不用看說明就會用。但它有個陷阱——直覺是相對於經驗的，對工程師直覺的介面對一般使用者未必如此。因此嚴謹的寫作會說 intuitive to whom。另一個意思是形容人的判斷靠直覺。",
        "grammarPatterns": [
          "intuitive to + somebody",
          "counter-intuitive"
        ],
        "collocations": [
          {
            "text": "an intuitive interface",
            "meaningZh": "直覺的介面"
          },
          {
            "text": "counter-intuitive",
            "meaningZh": "反直覺的",
            "example": {
              "en": "The result is counter-intuitive: adding threads made it slower.",
              "zh": "這個結果與直覺相反：增加執行緒反而讓它變慢了。",
              "highlight": "counter-intuitive"
            }
          },
          {
            "text": "not immediately intuitive",
            "meaningZh": "不是一看就懂的"
          }
        ],
        "examples": [
          {
            "en": "The API is powerful but not intuitive; everyone reads the docs twice.",
            "zh": "這個 API 很強大，但不夠直覺，每個人都得把文件看兩遍。",
            "highlight": "intuitive"
          },
          {
            "en": "What feels intuitive to the author is rarely intuitive to the user.",
            "zh": "作者覺得直覺的東西，使用者往往不覺得。",
            "highlight": "intuitive"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "self-explanatory",
        "noteZh": "不需額外說明即可理解的。"
      },
      {
        "lemma": "instinctive",
        "noteZh": "多形容人的反應。"
      }
    ],
    "antonyms": [
      {
        "lemma": "counter-intuitive",
        "noteZh": "違反直覺的。"
      },
      {
        "lemma": "unintuitive",
        "noteZh": "不易憑直覺理解的。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "obvious",
        "distinctionZh": "obvious 是「一眼就看得出來」，關乎可見度；intuitive 是「不必學就會用」，關乎符合預期。一個按鈕可以很 obvious（很顯眼）卻不 intuitive（看不出按了會怎樣）。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "intuition",
        "partOfSpeech": "noun",
        "meaningZh": "直覺"
      },
      {
        "lemma": "intuitively",
        "partOfSpeech": "adverb",
        "meaningZh": "直覺上"
      }
    ],
    "tags": [
      "engineering",
      "design",
      "product"
    ]
  },
  {
    "id": "w_legitimate",
    "lemma": "legitimate",
    "slug": "legitimate",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ləˈdʒɪtəmət/",
      "syllables": "le·git·i·mate",
      "stressNote": "重音在第二音節 -git-；形容詞字尾讀 /mət/。"
    },
    "senses": [
      {
        "id": "s_legitimate_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "business",
          "technical"
        ],
        "definitionEn": "reasonable and justified, or allowed by the rules",
        "definitionZh": "正當的；合理的；合法的",
        "usageExplanationZh": "legitimate 橫跨兩個語域。法律語境中指「合法的」；日常論述中則指「站得住腳、值得認真對待的」——a legitimate concern 是「合情合理的疑慮」，這個用法在職場溝通中非常實用，因為它承認對方的立場而不必同意其結論。資安語境中則指「正常的、非攻擊的」流量。",
        "grammarPatterns": [
          "a legitimate + noun",
          "perfectly legitimate"
        ],
        "collocations": [
          {
            "text": "a legitimate concern",
            "meaningZh": "合理的疑慮",
            "example": {
              "en": "That is a legitimate concern, and we should address it in the design.",
              "zh": "這是個合理的疑慮，我們應該在設計中處理它。",
              "highlight": "a legitimate concern"
            }
          },
          {
            "text": "legitimate traffic",
            "meaningZh": "正常流量"
          },
          {
            "text": "perfectly legitimate",
            "meaningZh": "完全正當的"
          },
          {
            "text": "a legitimate use case",
            "meaningZh": "正當的使用情境"
          }
        ],
        "examples": [
          {
            "en": "The filter blocks attacks but also drops some legitimate requests.",
            "zh": "這個過濾器擋下了攻擊，但也誤擋了一些正常的請求。",
            "highlight": "legitimate"
          },
          {
            "en": "There are legitimate reasons to keep the old endpoint alive.",
            "zh": "保留舊端點確實有正當的理由。",
            "highlight": "legitimate"
          }
        ],
        "usageNotes": [
          "動詞形是 legitimize（使合法化），字尾發音為 /maɪz/，與形容詞的 /mət/ 不同。"
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "valid",
        "noteZh": "有根據、合理有效的。"
      },
      {
        "lemma": "lawful",
        "noteZh": "僅限法律意義。"
      }
    ],
    "antonyms": [
      {
        "lemma": "illegitimate",
        "noteZh": "不合法或不正當的。"
      },
      {
        "wordId": "w_spurious",
        "lemma": "spurious",
        "noteZh": "虛假、缺乏根據的。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "valid",
        "distinctionZh": "valid 偏向「形式或邏輯上成立」（a valid token、a valid argument）；legitimate 偏向「正當、站得住腳」，帶有價值判斷。權杖格式對是 valid，擔憂合情合理則是 legitimate。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "legitimacy",
        "partOfSpeech": "noun",
        "meaningZh": "正當性"
      },
      {
        "lemma": "legitimize",
        "partOfSpeech": "verb",
        "meaningZh": "使正當化"
      }
    ],
    "tags": [
      "business",
      "security",
      "argument"
    ]
  },
  {
    "id": "w_marginal",
    "lemma": "marginal",
    "slug": "marginal",
    "cefr": "C1",
    "pronunciation": {
      "kk": "/ˈmɑrdʒənəl/",
      "syllables": "mar·gin·al",
      "stressNote": "重音在第一音節。"
    },
    "senses": [
      {
        "id": "s_marginal_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "business",
          "academic"
        ],
        "definitionEn": "so small in effect or importance that it barely matters",
        "definitionZh": "微小的；影響有限的",
        "usageExplanationZh": "marginal 表示「小到幾乎不值得在意」，語氣上比 negligible 稍弱——marginal 還是有影響，只是不大。它常用來婉轉地否定一項提案：a marginal improvement 聽起來客氣，實際上是在說「不值得為此付出成本」。",
        "grammarPatterns": [
          "a marginal + noun",
          "at the margin"
        ],
        "collocations": [
          {
            "text": "a marginal improvement",
            "meaningZh": "有限的改善",
            "example": {
              "en": "Six weeks of work produced only a marginal improvement.",
              "zh": "六週的工作只換來了非常有限的改善。",
              "highlight": "a marginal improvement"
            }
          },
          {
            "text": "marginal gains",
            "meaningZh": "邊際效益"
          },
          {
            "text": "marginal cost",
            "meaningZh": "邊際成本"
          }
        ],
        "examples": [
          {
            "en": "The difference is marginal at small scale but significant at scale.",
            "zh": "這個差異在小規模時微不足道，但規模一大就很顯著。",
            "highlight": "marginal"
          },
          {
            "en": "Beyond four replicas the marginal benefit is close to zero.",
            "zh": "超過四個副本之後，邊際效益幾乎等於零。",
            "highlight": "marginal"
          }
        ],
        "usageNotes": [
          "經濟學中的 marginal cost / marginal benefit 是專門術語，指「再多做一單位所增加的成本或效益」，與「微小」的日常義不同。"
        ]
      }
    ],
    "synonyms": [
      {
        "wordId": "w_negligible",
        "lemma": "negligible",
        "noteZh": "更強，指小到可完全忽略。"
      },
      {
        "lemma": "slight",
        "noteZh": "輕微的。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_substantial",
        "lemma": "substantial",
        "noteZh": "可觀、程度大的。"
      },
      {
        "lemma": "significant",
        "noteZh": "顯著而重要的。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "negligible",
        "wordId": "w_negligible",
        "distinctionZh": "marginal 是「小，但還在」；negligible 是「小到可以當作不存在」。若你仍要把它納入計算，用 marginal；若你打算直接忽略，用 negligible。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "margin",
        "partOfSpeech": "noun",
        "meaningZh": "邊緣；利潤空間"
      },
      {
        "lemma": "marginally",
        "partOfSpeech": "adverb",
        "meaningZh": "些微地"
      }
    ],
    "tags": [
      "business",
      "academic",
      "quantity"
    ]
  }
]
