[
  {
    "id": "w_obfuscate",
    "lemma": "obfuscate",
    "slug": "obfuscate",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ˈɑbfəˌsket/",
      "syllables": "ob·fus·cate",
      "stressNote": "主重音在第一音節，第三音節有次重音。"
    },
    "forms": {
      "past": "obfuscated",
      "pastParticiple": "obfuscated",
      "presentParticiple": "obfuscating",
      "thirdPersonSingular": "obfuscates"
    },
    "senses": [
      {
        "id": "s_obfuscate_1",
        "partOfSpeech": "verb",
        "register": [
          "formal",
          "academic"
        ],
        "definitionEn": "to make something deliberately unclear or harder to understand",
        "definitionZh": "刻意使模糊；把話說得讓人看不懂",
        "usageExplanationZh": "obfuscate 幾乎總是批評：把本來可以說清楚的事情弄得晦澀，通常是為了掩飾。它正好是 elucidate 的反義詞。技術語境中另有中性用法：code obfuscation 指刻意混淆程式碼以防止逆向工程，此時「難懂」是設計目的。",
        "grammarPatterns": [
          "obfuscate + noun",
          "obfuscate rather than clarify"
        ],
        "collocations": [
          {
            "text": "obfuscate the issue",
            "meaningZh": "把問題模糊掉",
            "example": {
              "en": "The summary obfuscates the issue instead of naming the cause.",
              "zh": "這份摘要把問題模糊帶過，而沒有指出原因。",
              "highlight": "obfuscates the issue"
            }
          },
          {
            "text": "deliberately obfuscate",
            "meaningZh": "刻意混淆"
          },
          {
            "text": "code obfuscation",
            "meaningZh": "程式碼混淆"
          }
        ],
        "examples": [
          {
            "en": "Jargon that obfuscates rather than clarifies has no place in a postmortem.",
            "zh": "讓人更看不懂而非更清楚的行話，不該出現在事後檢討中。",
            "highlight": "obfuscates"
          },
          {
            "en": "Obfuscation slows an attacker down; it is not a security control.",
            "zh": "混淆只能拖慢攻擊者，並不算是一種安全控制措施。",
            "highlight": "Obfuscation"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "obscure",
        "noteZh": "亦可作形容詞（晦澀的）。"
      },
      {
        "lemma": "muddy",
        "noteZh": "指使問題或意思混淆。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_elucidate",
        "lemma": "elucidate",
        "noteZh": "指清楚闡明。"
      },
      {
        "lemma": "clarify",
        "noteZh": "指澄清意思。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "obscure",
        "distinctionZh": "obscure 作動詞時可以是無意的遮蔽（clouds obscure the view），也可作形容詞（晦澀的）；obfuscate 一定是刻意的動作，且幾乎只用於語言或程式碼。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "obfuscation",
        "partOfSpeech": "noun",
        "meaningZh": "混淆"
      }
    ],
    "tags": [
      "academic",
      "security",
      "communication"
    ]
  },
  {
    "id": "w_precarious",
    "lemma": "precarious",
    "slug": "precarious",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/prɪˈkɛrɪəs/",
      "syllables": "pre·car·i·ous",
      "stressNote": "重音在第二音節 -car-。"
    },
    "senses": [
      {
        "id": "s_precarious_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "literary"
        ],
        "definitionEn": "not securely held or supported, and therefore likely to fail at any moment",
        "definitionZh": "岌岌可危的；不穩固的",
        "usageExplanationZh": "precarious 的意象是「搖搖欲墜」：現在還撐著，但隨時可能崩塌。它比 fragile 多了「持續處於危險狀態」的時間感。用於形容處境、平衡與依賴關係時特別傳神：a precarious dependency on one vendor。",
        "grammarPatterns": [
          "a precarious + noun",
          "in a precarious position"
        ],
        "collocations": [
          {
            "text": "a precarious position",
            "meaningZh": "岌岌可危的處境"
          },
          {
            "text": "a precarious balance",
            "meaningZh": "脆弱的平衡",
            "example": {
              "en": "The schedule maintains a precarious balance between speed and safety.",
              "zh": "這份時程在速度與安全之間維持著脆弱的平衡。",
              "highlight": "a precarious balance"
            }
          },
          {
            "text": "increasingly precarious",
            "meaningZh": "越來越危險的"
          }
        ],
        "examples": [
          {
            "en": "Relying on one engineer who knows the system is a precarious arrangement.",
            "zh": "只靠一位懂這個系統的工程師，是一種岌岌可危的安排。",
            "highlight": "precarious"
          },
          {
            "en": "The service survived, but its position was precarious all night.",
            "zh": "服務撐住了，但整晚都處在隨時可能崩潰的狀態。",
            "highlight": "precarious"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "unstable",
        "noteZh": "指不穩定、可能失敗的。"
      },
      {
        "lemma": "fragile",
        "noteZh": "指脆弱而容易受損的。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_robust",
        "lemma": "robust",
        "noteZh": "指強健而能承受壓力的。"
      },
      {
        "lemma": "secure",
        "noteZh": "指穩固而安全的。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "precocious",
        "distinctionZh": "precarious 是「岌岌可危的」，precocious 是「早熟的」。兩字開頭相同但意思毫無關聯，是拼寫檢查抓不到的錯誤。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "precariously",
        "partOfSpeech": "adverb",
        "meaningZh": "危險地"
      }
    ],
    "tags": [
      "risk",
      "description",
      "business"
    ]
  },
  {
    "id": "w_spurious",
    "lemma": "spurious",
    "slug": "spurious",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ˈspjʊrɪəs/",
      "syllables": "spu·ri·ous",
      "stressNote": "重音在第一音節。"
    },
    "senses": [
      {
        "id": "s_spurious_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic",
          "technical"
        ],
        "definitionEn": "false or not genuine, although it appears to be real or valid",
        "definitionZh": "虛假的；似是而非的",
        "usageExplanationZh": "spurious 的關鍵是「看起來像真的，其實不是」。統計學中的 a spurious correlation（偽相關）是核心概念：兩個變數看似有關，實則由第三個因素造成。技術語境中 spurious wakeups、spurious errors 則指「無實際原因卻出現的」訊號。",
        "grammarPatterns": [
          "a spurious + noun",
          "spurious correlation between A and B"
        ],
        "collocations": [
          {
            "text": "a spurious correlation",
            "meaningZh": "偽相關",
            "example": {
              "en": "Ice cream sales and drowning deaths show a spurious correlation.",
              "zh": "冰淇淋銷量與溺水死亡人數呈現的是偽相關。",
              "highlight": "a spurious correlation"
            }
          },
          {
            "text": "spurious errors",
            "meaningZh": "無實際原因的錯誤"
          },
          {
            "text": "a spurious claim",
            "meaningZh": "站不住腳的主張"
          }
        ],
        "examples": [
          {
            "en": "Filter out spurious alerts before they train everyone to ignore the pager.",
            "zh": "把假警報過濾掉，免得大家學會忽略呼叫器。",
            "highlight": "spurious"
          },
          {
            "en": "The link between the two metrics turned out to be spurious.",
            "zh": "這兩項指標之間的關聯，結果證實是虛假的。",
            "highlight": "spurious"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "bogus",
        "noteZh": "較口語。"
      },
      {
        "lemma": "specious",
        "noteZh": "特指「表面上有道理」的論證。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_legitimate",
        "lemma": "legitimate",
        "noteZh": "指合理或有正當根據的。"
      },
      {
        "lemma": "genuine",
        "noteZh": "指真實而非偽造的。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "spontaneous",
        "distinctionZh": "spurious 是「假的、似是而非的」，spontaneous 是「自發的、未經安排的」。兩字開頭相似但語意無關。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "spuriously",
        "partOfSpeech": "adverb",
        "meaningZh": "虛假地"
      }
    ],
    "tags": [
      "academic",
      "data",
      "research"
    ]
  },
  {
    "id": "w_tacit",
    "lemma": "tacit",
    "slug": "tacit",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ˈtæsɪt/",
      "syllables": "tac·it",
      "stressNote": "重音在第一音節。"
    },
    "senses": [
      {
        "id": "s_tacit_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic",
          "business"
        ],
        "definitionEn": "understood or agreed without being said or written down",
        "definitionZh": "默許的；心照不宣的",
        "usageExplanationZh": "tacit 表示「大家都知道、但沒有人說出口」。它與 implicit 很接近，差別在於 tacit 特別強調「有共識存在」——tacit agreement 是雙方都心知肚明的默契。知識管理中的 tacit knowledge（內隱知識）指難以文件化、只能靠實作傳承的經驗。",
        "grammarPatterns": [
          "tacit agreement",
          "tacit approval",
          "tacit knowledge"
        ],
        "collocations": [
          {
            "text": "tacit agreement",
            "meaningZh": "默契；不成文的共識",
            "example": {
              "en": "There is a tacit agreement that nobody deploys on Friday.",
              "zh": "大家有個不成文的默契：星期五不部署。",
              "highlight": "a tacit agreement"
            }
          },
          {
            "text": "tacit approval",
            "meaningZh": "默許"
          },
          {
            "text": "tacit knowledge",
            "meaningZh": "內隱知識"
          }
        ],
        "examples": [
          {
            "en": "Silence in a review is often read as tacit approval.",
            "zh": "審查時的沉默，往往會被解讀為默許。",
            "highlight": "tacit"
          },
          {
            "en": "Most of what makes the team effective is tacit knowledge.",
            "zh": "讓這個團隊有效率的，多半是難以言傳的內隱知識。",
            "highlight": "tacit"
          }
        ],
        "usageNotes": [
          "tacit 意味著「沒有說出口或寫下來」，與「以書面形式」直接矛盾。誤：They gave their tacit agreement in writing.／正：They gave their agreement in writing."
        ]
      }
    ],
    "synonyms": [
      {
        "wordId": "w_implicit",
        "lemma": "implicit",
        "noteZh": "指隱含而未明說的。"
      },
      {
        "lemma": "unspoken",
        "noteZh": "指未說出口的。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_explicit",
        "lemma": "explicit",
        "noteZh": "指明確表達的。"
      },
      {
        "lemma": "stated",
        "noteZh": "指已明白說出的。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "implicit",
        "wordId": "w_implicit",
        "distinctionZh": "implicit 是「內含於某事物之中」，可以是單方面的（an assumption implicit in the design）；tacit 特別指「雙方都心知肚明卻不說破的共識或許可」，因此幾乎只用於協議、認可與知識。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "tacitly",
        "partOfSpeech": "adverb",
        "meaningZh": "默許地"
      }
    ],
    "tags": [
      "business",
      "communication",
      "academic"
    ]
  },
  {
    "id": "w_tangential",
    "lemma": "tangential",
    "slug": "tangential",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/tænˈdʒɛnʃəl/",
      "syllables": "tan·gen·tial",
      "stressNote": "重音在第二音節 -gen-。"
    },
    "senses": [
      {
        "id": "s_tangential_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic"
        ],
        "definitionEn": "only slightly connected to the subject being discussed, and therefore a distraction",
        "definitionZh": "離題的；只沾到邊的",
        "usageExplanationZh": "tangential 來自幾何的「切線」：只碰到一個點就往別的方向去了。用它來評論一段發言，是很有禮貌卻明確的提醒：that is tangential to the decision we need to make。介系詞用 to。",
        "grammarPatterns": [
          "tangential to + noun",
          "a tangential point"
        ],
        "collocations": [
          {
            "text": "tangential to",
            "meaningZh": "與……只有間接關係",
            "example": {
              "en": "That concern is tangential to the decision we need to make today.",
              "zh": "那個疑慮與我們今天要做的決定只有間接關係。",
              "highlight": "tangential to"
            }
          },
          {
            "text": "a tangential remark",
            "meaningZh": "離題的發言"
          },
          {
            "text": "only tangentially related",
            "meaningZh": "只有些微關聯的"
          }
        ],
        "examples": [
          {
            "en": "The discussion drifted into tangential territory for twenty minutes.",
            "zh": "討論岔題了二十分鐘。",
            "highlight": "tangential"
          },
          {
            "en": "Interesting, but tangential — let us take it offline.",
            "zh": "很有意思，但離題了，我們會後再談。",
            "highlight": "tangential"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "wordId": "w_extraneous",
        "lemma": "extraneous",
        "noteZh": "指與主題無關的。"
      },
      {
        "lemma": "peripheral",
        "noteZh": "指與核心僅有間接關聯的。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_relevant",
        "lemma": "relevant",
        "noteZh": "指切題而相關的。"
      },
      {
        "wordId": "w_salient",
        "lemma": "salient",
        "noteZh": "指突出的重點；屬語境對比而非嚴格反義。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "irrelevant",
        "distinctionZh": "irrelevant 是「完全無關」，語氣較重；tangential 承認有一點關聯，只是不在重點上，因此在會議中用它比較不傷人。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "tangent",
        "partOfSpeech": "noun",
        "meaningZh": "切線；離題的話"
      },
      {
        "lemma": "tangentially",
        "partOfSpeech": "adverb",
        "meaningZh": "間接地"
      }
    ],
    "tags": [
      "academic",
      "communication",
      "writing"
    ]
  },
  {
    "id": "w_untenable",
    "lemma": "untenable",
    "slug": "untenable",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ənˈtɛnəbəl/",
      "syllables": "un·ten·a·ble",
      "stressNote": "重音在第二音節 -ten-。"
    },
    "senses": [
      {
        "id": "s_untenable_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic",
          "business"
        ],
        "definitionEn": "impossible to defend or to continue with, because of the problems it creates",
        "definitionZh": "站不住腳的；難以為繼的",
        "usageExplanationZh": "untenable 用於兩種對象：立場或論點「無法辯護」，以及處境「撐不下去」。它比 wrong 或 difficult 有力得多，因為它宣稱「這件事根本無法維持」。片語 become untenable 常用來描述情況惡化到必須改變的臨界點。",
        "grammarPatterns": [
          "an untenable position",
          "become untenable"
        ],
        "collocations": [
          {
            "text": "an untenable position",
            "meaningZh": "站不住腳的立場",
            "example": {
              "en": "Supporting two incompatible APIs became an untenable position.",
              "zh": "同時支援兩套不相容的 API，最後變成一個難以為繼的立場。",
              "highlight": "an untenable position"
            }
          },
          {
            "text": "become untenable",
            "meaningZh": "變得難以維持"
          },
          {
            "text": "logically untenable",
            "meaningZh": "邏輯上站不住腳的"
          }
        ],
        "examples": [
          {
            "en": "Maintaining four release branches is untenable with three engineers.",
            "zh": "只有三位工程師卻要維護四條發布分支，根本撐不下去。",
            "highlight": "untenable"
          },
          {
            "en": "Once the data came in, the original hypothesis was untenable.",
            "zh": "數據一進來，原本的假說就站不住腳了。",
            "highlight": "untenable"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "indefensible",
        "noteZh": "指無法合理辯護的。"
      },
      {
        "lemma": "unsustainable",
        "noteZh": "偏向資源上撐不下去。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_viable",
        "lemma": "viable",
        "noteZh": "指實際可行的。"
      },
      {
        "lemma": "tenable",
        "noteZh": "指可合理維持或辯護的。"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "infeasible",
        "distinctionZh": "infeasible 是「做不到」，關乎執行可能性；untenable 是「守不住、辯護不了」，關乎立場或處境能否維持。在兩週內重寫是 infeasible，長期同時維護四條分支則是 untenable。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "tenable",
        "partOfSpeech": "adjective",
        "meaningZh": "站得住腳的"
      }
    ],
    "tags": [
      "academic",
      "argument",
      "business"
    ]
  }
]
