[
  {
    "id": "w_cogent",
    "lemma": "cogent",
    "slug": "cogent",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ˈkodʒənt/",
      "syllables": "co·gent",
      "stressNote": "重音在第一音節；字首讀作長音 /ko/。"
    },
    "senses": [
      {
        "id": "s_cogent_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic"
        ],
        "definitionEn": "clearly reasoned and therefore convincing",
        "definitionZh": "有說服力的（因論理清晰而令人信服）",
        "usageExplanationZh": "cogent 稱讚的是論證的「邏輯品質」，而不是情感感染力。這使它與 compelling 有微妙分工：compelling 可以形容一個動人的故事，cogent 只能形容站得住腳的推理。它幾乎只修飾 argument、case、reason、analysis 這類名詞。",
        "grammarPatterns": [
          "a cogent argument",
          "make a cogent case for + noun"
        ],
        "collocations": [
          {
            "text": "a cogent argument",
            "meaningZh": "論理嚴密的論證",
            "example": {
              "en": "She made a cogent argument for deferring the migration.",
              "zh": "她提出了一個論理嚴密的論證，主張延後這次遷移。",
              "highlight": "a cogent argument"
            }
          },
          {
            "text": "a cogent explanation",
            "meaningZh": "條理清楚的解釋"
          },
          {
            "text": "cogent reasoning",
            "meaningZh": "嚴謹的推理"
          }
        ],
        "examples": [
          {
            "en": "The proposal is cogent, even if I disagree with its conclusion.",
            "zh": "這份提案論理嚴密，儘管我不同意它的結論。",
            "highlight": "cogent"
          },
          {
            "en": "Nobody offered a cogent reason for keeping both code paths.",
            "zh": "沒有人提出保留兩條程式路徑的有力理由。",
            "highlight": "cogent"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "wordId": "w_compelling",
        "lemma": "compelling",
        "noteZh": "力道更強，可含情感因素。"
      },
      {
        "lemma": "persuasive",
        "noteZh": "有說服力的"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_tenuous",
        "lemma": "tenuous",
        "noteZh": "論據薄弱的"
      },
      {
        "lemma": "incoherent",
        "noteZh": "缺乏條理連貫的"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "compelling",
        "wordId": "w_compelling",
        "distinctionZh": "cogent 專指「推理嚴謹因而使人信服」；compelling 泛指「強到讓人不得不接受」，可以來自證據、也可以來自敘事的感染力。學術審查偏好 cogent，行銷簡報偏好 compelling。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "cogency",
        "partOfSpeech": "noun",
        "meaningZh": "說服力；論理嚴密性"
      }
    ],
    "tags": [
      "academic",
      "argument",
      "writing"
    ]
  },
  {
    "id": "w_disparity",
    "lemma": "disparity",
    "slug": "disparity",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/dɪˈspɛrətɪ/",
      "syllables": "dis·par·i·ty",
      "stressNote": "重音在第二音節 -par-。"
    },
    "forms": {
      "plural": "disparities"
    },
    "senses": [
      {
        "id": "s_disparity_1",
        "partOfSpeech": "noun",
        "register": [
          "formal",
          "academic"
        ],
        "definitionEn": "a large difference between two things, especially one that seems unfair",
        "definitionZh": "顯著落差；不對等的差距",
        "usageExplanationZh": "disparity 指「大到值得注意、而且往往不公平」的差距。它比 difference 帶有更強的評價色彩，因此常用於社會科學與績效分析：income disparity、a disparity in access。介系詞用 between 或 in。",
        "grammarPatterns": [
          "a disparity between A and B",
          "a disparity in + noun"
        ],
        "collocations": [
          {
            "text": "a disparity between",
            "meaningZh": "……之間的落差",
            "example": {
              "en": "There is a striking disparity between what the docs promise and what ships.",
              "zh": "文件的承諾與實際交付之間存在驚人的落差。",
              "highlight": "a striking disparity between"
            }
          },
          {
            "text": "a wide disparity",
            "meaningZh": "巨大的差距"
          },
          {
            "text": "income disparity",
            "meaningZh": "所得差距"
          },
          {
            "text": "address the disparity",
            "meaningZh": "處理這個落差"
          }
        ],
        "examples": [
          {
            "en": "The disparity in review latency between teams is hard to justify.",
            "zh": "各團隊之間審查等待時間的落差，很難說得過去。",
            "highlight": "disparity"
          },
          {
            "en": "Latency disparities across regions frustrate users the most.",
            "zh": "各區域之間的延遲落差最讓使用者不滿。",
            "highlight": "disparities"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "inequality",
        "noteZh": "不平等"
      },
      {
        "lemma": "gap",
        "noteZh": "差距"
      }
    ],
    "antonyms": [
      {
        "lemma": "parity",
        "noteZh": "對等；同等"
      },
      {
        "lemma": "equivalence",
        "noteZh": "相等或等值"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "discrepancy",
        "wordId": "w_discrepancy",
        "distinctionZh": "discrepancy 是「兩份本應相同的紀錄對不起來」，是資料問題；disparity 是「兩者本來就不同，但差距大到不合理」，是公平性問題。帳目不符用 discrepancy，薪資差距用 disparity。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "disparate",
        "partOfSpeech": "adjective",
        "meaningZh": "迥異的"
      }
    ],
    "tags": [
      "academic",
      "research",
      "comparison"
    ]
  },
  {
    "id": "w_elucidate",
    "lemma": "elucidate",
    "slug": "elucidate",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ɪˈlusəˌdet/",
      "syllables": "e·lu·ci·date",
      "stressNote": "主重音在第二音節 -lu-。"
    },
    "forms": {
      "past": "elucidated",
      "pastParticiple": "elucidated",
      "presentParticiple": "elucidating",
      "thirdPersonSingular": "elucidates"
    },
    "senses": [
      {
        "id": "s_elucidate_1",
        "partOfSpeech": "verb",
        "register": [
          "formal",
          "academic",
          "literary"
        ],
        "definitionEn": "to make something clearer by explaining it in more detail",
        "definitionZh": "闡明；把（複雜之事）解釋清楚",
        "usageExplanationZh": "elucidate 的字根與「光」有關，意象是「照亮原本晦暗之處」。它比 explain 正式得多，多見於學術寫作與正式簡報。受詞通常是複雜的機制、關係或概念。日常對話中使用會顯得過於文縐縐。",
        "grammarPatterns": [
          "elucidate + noun",
          "elucidate how/why + clause"
        ],
        "collocations": [
          {
            "text": "elucidate the mechanism",
            "meaningZh": "闡明機制",
            "example": {
              "en": "The follow-up study elucidates the mechanism behind the effect.",
              "zh": "後續研究闡明了這個效應背後的機制。",
              "highlight": "elucidates the mechanism"
            }
          },
          {
            "text": "further elucidate",
            "meaningZh": "進一步闡明"
          },
          {
            "text": "elucidate the relationship",
            "meaningZh": "釐清兩者的關係"
          }
        ],
        "examples": [
          {
            "en": "The diagram elucidates a control flow that the prose obscures.",
            "zh": "這張圖闡明了文字反而弄糊塗的控制流程。",
            "highlight": "elucidates"
          },
          {
            "en": "Could you elucidate why the second query is necessary?",
            "zh": "能否請您說明為什麼需要第二次查詢？",
            "highlight": "elucidate"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "clarify",
        "noteZh": "澄清使易懂"
      },
      {
        "lemma": "explain",
        "noteZh": "中性、日常。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_obfuscate",
        "lemma": "obfuscate",
        "noteZh": "使模糊難懂"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "illustrate",
        "distinctionZh": "illustrate 是「舉例或用圖說明」，靠具體實例；elucidate 是「把複雜難懂之處講清楚」，靠拆解與分析。舉個例子是 illustrate，解釋整套機制是 elucidate。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "elucidation",
        "partOfSpeech": "noun",
        "meaningZh": "闡明"
      }
    ],
    "tags": [
      "academic",
      "writing",
      "communication"
    ]
  },
  {
    "id": "w_equivocal",
    "lemma": "equivocal",
    "slug": "equivocal",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ɪˈkwɪvəkəl/",
      "syllables": "e·quiv·o·cal",
      "stressNote": "重音在第二音節 -quiv-。"
    },
    "senses": [
      {
        "id": "s_equivocal_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic"
        ],
        "definitionEn": "open to more than one interpretation, often deliberately, so that no clear conclusion can be drawn",
        "definitionZh": "模稜兩可的；未能給出明確結論的",
        "usageExplanationZh": "equivocal 有兩種常見用法。形容研究結果時，它中性地表示「數據不足以下定論」：the results were equivocal。形容人的回答時，它往往帶有批評：對方刻意含糊以迴避表態。與 ambiguous 相比，equivocal 更常暗示「刻意」。",
        "grammarPatterns": [
          "equivocal results",
          "be equivocal about + noun"
        ],
        "collocations": [
          {
            "text": "equivocal results",
            "meaningZh": "無法下定論的結果",
            "example": {
              "en": "The A/B test produced equivocal results; the confidence interval spans zero.",
              "zh": "這次 A/B 測試的結果無法下定論，信賴區間跨越了零。",
              "highlight": "equivocal results"
            }
          },
          {
            "text": "an equivocal answer",
            "meaningZh": "模稜兩可的回答"
          },
          {
            "text": "remain equivocal",
            "meaningZh": "仍未明確表態"
          }
        ],
        "examples": [
          {
            "en": "The evidence is equivocal, so we should not change the default yet.",
            "zh": "證據尚無定論，因此我們還不該更動預設值。",
            "highlight": "equivocal"
          },
          {
            "en": "He was equivocal about whether the deadline could move.",
            "zh": "關於期限能不能延，他的說法模稜兩可。",
            "highlight": "equivocal"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "wordId": "w_ambiguous",
        "lemma": "ambiguous",
        "noteZh": "不必然是刻意的。"
      },
      {
        "lemma": "inconclusive",
        "noteZh": "只用於結果，不用於人。"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_explicit",
        "lemma": "explicit",
        "noteZh": "明確表達的"
      },
      {
        "lemma": "unequivocal",
        "noteZh": "毫不含糊的"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "ambiguous",
        "wordId": "w_ambiguous",
        "distinctionZh": "ambiguous 描述「可以有兩種解讀」，通常是無意造成的缺陷；equivocal 常暗示「刻意保留模糊空間以避免表態」，或用於「數據不足以下定論」。規格書寫得不好是 ambiguous，發言人閃避問題是 equivocal。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "unequivocal",
        "partOfSpeech": "adjective",
        "meaningZh": "毫不含糊的"
      },
      {
        "lemma": "equivocate",
        "partOfSpeech": "verb",
        "meaningZh": "含糊其辭"
      }
    ],
    "tags": [
      "academic",
      "research",
      "communication"
    ]
  },
  {
    "id": "w_extraneous",
    "lemma": "extraneous",
    "slug": "extraneous",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ɛkˈstrenɪəs/",
      "syllables": "ex·tra·ne·ous",
      "stressNote": "重音在第二音節 -tra-。"
    },
    "senses": [
      {
        "id": "s_extraneous_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "academic",
          "technical"
        ],
        "definitionEn": "not relevant to the matter at hand, and coming from outside it",
        "definitionZh": "無關的；外來而多餘的",
        "usageExplanationZh": "extraneous 同時包含兩層意思：既是「不相關」，也是「從外面混進來的」。這使它特別適合描述雜訊與干擾因素：extraneous noise、extraneous variables。與 redundant 的差別在於：redundant 是「重複因而多餘」，extraneous 是「根本不屬於這裡」。",
        "grammarPatterns": [
          "extraneous to + noun",
          "extraneous + noun"
        ],
        "collocations": [
          {
            "text": "extraneous detail",
            "meaningZh": "無關的細節",
            "example": {
              "en": "Strip out the extraneous detail; the reviewer only needs the diff.",
              "zh": "把無關的細節刪掉，審查者只需要看到差異。",
              "highlight": "the extraneous detail"
            }
          },
          {
            "text": "extraneous variables",
            "meaningZh": "外部干擾變項"
          },
          {
            "text": "extraneous to the argument",
            "meaningZh": "與論證無關的"
          }
        ],
        "examples": [
          {
            "en": "The experiment failed to control for extraneous factors.",
            "zh": "這個實驗沒有控制外部干擾因素。",
            "highlight": "extraneous"
          },
          {
            "en": "Anything extraneous to the failure belongs in an appendix.",
            "zh": "任何與這次故障無關的內容，都應該放在附錄。",
            "highlight": "extraneous to"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "irrelevant",
        "noteZh": "與主題無關的"
      },
      {
        "wordId": "w_tangential",
        "lemma": "tangential",
        "noteZh": "只間接相關的"
      }
    ],
    "antonyms": [
      {
        "wordId": "w_relevant",
        "lemma": "relevant",
        "noteZh": "相關的"
      },
      {
        "wordId": "w_inherent",
        "lemma": "inherent",
        "noteZh": "內在固有的（相對於外加的）"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "redundant",
        "wordId": "w_redundant",
        "distinctionZh": "redundant 是「重複了已有的東西」，本來就屬於這裡只是多了一份；extraneous 是「根本不屬於這裡」，從外部混入。刪掉重複的檢查是移除 redundancy，刪掉離題的段落是移除 extraneous material。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "extraneously",
        "partOfSpeech": "adverb",
        "meaningZh": "無關地"
      }
    ],
    "tags": [
      "academic",
      "research",
      "writing"
    ]
  },
  {
    "id": "w_innocuous",
    "lemma": "innocuous",
    "slug": "innocuous",
    "cefr": "C2",
    "pronunciation": {
      "kk": "/ɪˈnɑkjuəs/",
      "syllables": "in·noc·u·ous",
      "stressNote": "重音在第二音節 -noc-。"
    },
    "senses": [
      {
        "id": "s_innocuous_1",
        "partOfSpeech": "adjective",
        "register": [
          "formal",
          "technical"
        ],
        "definitionEn": "not harmful or offensive, especially when it appears that way but may not be",
        "definitionZh": "看似無害的；不具威脅的",
        "usageExplanationZh": "innocuous 最有力的用法帶有伏筆：說某件事 seemingly innocuous，等於預告它其實造成了大麻煩。事故報告與資安分析中極常見：an innocuous-looking config change。這種「表面無害」的語感讓它比 harmless 更適合敘事。",
        "grammarPatterns": [
          "seemingly innocuous",
          "an innocuous-looking + noun"
        ],
        "collocations": [
          {
            "text": "seemingly innocuous",
            "meaningZh": "看似無害的",
            "example": {
              "en": "A seemingly innocuous whitespace change broke the parser.",
              "zh": "一個看似無害的空白字元變更弄壞了剖析器。",
              "highlight": "seemingly innocuous"
            }
          },
          {
            "text": "an innocuous question",
            "meaningZh": "無傷大雅的問題"
          },
          {
            "text": "look innocuous",
            "meaningZh": "看起來沒有威脅性"
          }
        ],
        "examples": [
          {
            "en": "The payload looks innocuous until it reaches the template engine.",
            "zh": "這段內容在抵達樣板引擎之前看起來都無害。",
            "highlight": "innocuous"
          },
          {
            "en": "Most incidents start with an innocuous one-line change.",
            "zh": "多數事故都始於一行看似無害的變更。",
            "highlight": "innocuous"
          }
        ]
      }
    ],
    "synonyms": [
      {
        "lemma": "harmless",
        "noteZh": "無害的"
      },
      {
        "lemma": "benign",
        "noteZh": "亦用於醫學（良性的）。"
      }
    ],
    "antonyms": [
      {
        "lemma": "harmful",
        "noteZh": "有害的"
      },
      {
        "lemma": "malicious",
        "noteZh": "懷有惡意的"
      }
    ],
    "commonlyConfusedWith": [
      {
        "lemma": "innocent",
        "distinctionZh": "innocuous 是「不會造成傷害的」，描述事物的影響；innocent 是「無罪的、天真的」，描述人的責任或心態。一段看似無害的程式碼是 innocuous，被誤指的人才是 innocent。"
      }
    ],
    "wordFamily": [
      {
        "lemma": "innocuously",
        "partOfSpeech": "adverb",
        "meaningZh": "無害地"
      }
    ],
    "tags": [
      "security",
      "engineering",
      "description"
    ]
  }
]
